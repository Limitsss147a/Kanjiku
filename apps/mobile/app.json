{
  "expo": {
    "name": "Kanjiku",
    "slug": "kanjiku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kanjiku",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kanjiku.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "kanjiku"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FBF7EE",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kanjiku.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "kanjiku"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-file-system",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "69eb63d4-5964-4cb2-8b3a-b44b4956d343"
      }
    },
    "owner": "angga147a"
  }
}

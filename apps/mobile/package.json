{
  "name": "kanjiku-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "eas-build-post-install": "npm run build --workspace=@kanjiku/ui",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "detox test -c android.emu.release",
    "db:build": "node ../../packages/data-pipeline/dist/build.js",
    "db:verify": "node ../../packages/data-pipeline/dist/verify.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@kanjiku/ui": "*",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.1",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.1",
    "expo-font": "~58.0.1",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.5.0",
    "@types/react": "~19.3.0",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "detox": "^20.17.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "~30.5.2",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
